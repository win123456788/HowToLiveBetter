.about-h1 {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.about-h2 {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.about-p {
  font-size: 27rpx;
  color: #3d454f;
  line-height: 1.75;
  margin-bottom: 12rpx;
}

.about-p:last-child {
  margin-bottom: 0;
}

.about-btns {
  display: flex;
  margin-top: 20rpx;
}

.about-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #3a5ccc;
  background: #f4f6fd;
  border-radius: 12rpx;
  line-height: 2.6;
}

.about-btn + .about-btn {
  margin-left: 16rpx;
}
