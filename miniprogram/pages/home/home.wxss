.hero {
  padding: 30rpx 8rpx 34rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #7d8894;
}

.quick-row {
  display: flex;
}

.quick-row + .quick-row {
  margin-top: 16rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #3a5ccc;
  background: #f4f6fd;
  border-radius: 12rpx;
  line-height: 2.6;
}

.quick-btn + .quick-btn {
  margin-left: 16rpx;
}

.list-head {
  margin: 10rpx 8rpx 16rpx;
  font-size: 26rpx;
  color: #7d8894;
}

.sec-item {
  display: flex;
  align-items: center;
}

.sec-item-num {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #eef1f8;
  color: #3a5ccc;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  line-height: 56rpx;
  margin-right: 20rpx;
}

.sec-item-main {
  flex: 1;
  min-width: 0;
}

.sec-item-title {
  font-size: 31rpx;
  font-weight: 600;
}

.sec-item-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9aa4ae;
}

.sec-item-arrow {
  flex: none;
  color: #c3cad2;
  font-size: 36rpx;
  margin-left: 8rpx;
}

.foot {
  margin-top: 30rpx;
  text-align: center;
  font-size: 23rpx;
  color: #a5adb6;
}
