.sec-head {
  background: linear-gradient(135deg, #ffffff 0%, #f2f5ff 100%);
}

.sec-kicker {
  font-size: 24rpx;
  color: #3a5ccc;
  margin-bottom: 8rpx;
}

.sec-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.sec-stats {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7d8894;
}

.sec-intro .intro-para {
  margin-bottom: 14rpx;
  color: #3d454f;
  font-size: 27rpx;
}

.sec-intro .intro-para:last-child {
  margin-bottom: 0;
}

.intro-toggle {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #3a5ccc;
  text-align: center;
}

.filters {
  padding-top: 20rpx;
  padding-bottom: 10rpx;
}

.filter-row {
  margin-bottom: 12rpx;
}

.filter-row .chip {
  margin-bottom: 10rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #7d8894;
  margin-right: 12rpx;
}

.entry-item {
  padding: 24rpx 28rpx;
}

.entry-title-row {
  display: flex;
  align-items: flex-start;
}

.entry-num {
  flex: none;
  min-width: 44rpx;
  height: 44rpx;
  border-radius: 10rpx;
  background: #eef1f8;
  color: #3a5ccc;
  font-size: 24rpx;
  text-align: center;
  line-height: 44rpx;
  margin-right: 14rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  flex: 1;
}

.entry-snippet {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #6d7885;
  line-height: 1.6;
}

.entry-chips {
  margin-top: 14rpx;
}

.entry-chips .chip {
  margin-bottom: 0;
}
